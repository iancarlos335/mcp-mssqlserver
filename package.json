{
  "name": "mcp-mssqlserver",
  "version": "2.0.0",
  "description": "CLI for querying, inspecting, and analyzing Microsoft SQL Server, with an installable agent Skill",
  "type": "module",
  "bin": {
    "mssql-cli": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "hooks:install": "husky",
    "start": "node dist/cli.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "fast-xml-parser": "^5.9.3",
    "mssql": "^11.0.1",
    "msnodesqlv8": "^5.1.1"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
